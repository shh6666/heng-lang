注：==============================================================
注：  衡 OS · 图形控制台
注：
注：  用衡语 + libhengui 写的系统监控面板：
注：    左：子系统状态      中：启动日志
注：    右：AI 进化曲线     底：操作按钮与状态栏
注：==============================================================

导入 外部 "libhengui.dylib" 之 界面
导入 「kernel.hng」之 内核
导入 「ai_engine.hng」之 进化
导入 「apps.hng」之 应用
导入 「image.hng」之 镜像

常量 面 : 映射 文本 文本 = {}

定义 做法 换行() -> 文本:
  返回 文字.由码点(10)
结束

定义 做法 置(k : 文本, v : 文本) -> 空:
  将 v 放到 面[k]
结束

定义 做法 取(k : 文本) -> 文本:
  如果 字典.有键(面, k):
    返回 面[k]
  结束
  返回 ""
结束

定义 做法 日志(内容 : 文本) -> 空:
  变量 旧 : 文本 = 取("日志")
  如果 文字.长度(旧) = 0:
    置("日志", 内容)
  否则:
    置("日志", 旧 + 换行() + 内容)
  结束
  界面.界面_文本_t("日志|" + 取("日志"))
结束

定义 做法 刷新状态() -> 空:
  变量 行 : 序列 文本 = []
  行 = 表.追加(行, "子系统状态")
  行 = 表.追加(行, "──────────────")
  行 = 表.追加(行, "内核时钟    " + 化成文(内核.内核["时钟"]))
  行 = 表.追加(行, "完成进程    " + 化成文(内核.内核["完成进程"]))
  行 = 表.追加(行, "上下文切换  " + 化成文(内核.内核["上下文切换"]))
  行 = 表.追加(行, "已用内存    " + 化成文(内核.内核["已用内存"]))
  行 = 表.追加(行, "            / " + 化成文(内核.内核["内存总量"]))
  行 = 表.追加(行, "非法请求    " + 化成文(内核.内核["拒绝次数"]))
  行 = 表.追加(行, "越权拒绝    " + 化成文(应用.权限统计["拒绝次数"]))
  行 = 表.追加(行, "AI 代数     " + 化成文(进化.进化["代数"]))
  界面.界面_文本_t("状态区|" + 文字.合并(行, 换行()))
结束

定义 做法 做启动() -> 空:
  日志("▶ 内核初始化")
  内核.初始化内核()
  应用.初始化权限统计()
  日志("  内存 " + 化成文(内核.内核["内存总量"]) + " 字节")
  刷新状态()
  日志("▶ 注册应用")
  应用.注册应用("相册", 8192, 20, ["存储.读"])
  应用.注册应用("设置", 4096, 10, ["存储.读", "存储.写"])
  应用.注册应用("相机", 16384, 35, ["摄像头"])
  每个 应用.应用表 为 a:
    日志("  " + a.名 + " 内存 " + 化成文(a.内存需求))
  结束
  刷新状态()
  日志("▶ 启动完成")
结束

定义 做法 做调度() -> 空:
  日志("▶ 创建进程并调度")
  内核.创建进程("相册", 3, 10, 8192)
  内核.创建进程("设置", 2, 6, 4096)
  内核.创建进程("相机", 5, 18, 16384)
  内核.创建进程("后台同步", 1, 25, 2048)
  日志("  4 个进程已就绪")
  变量 步 : 数 = 0
  循环 内核.就绪数() > 0 并且 步 < 100:
    内核.推进一步(2, 0.3)
    步 = 步 + 1
  结束
  内核.回收已完成()
  日志("  调度 " + 化成文(步) + " 步完成")
  刷新状态()
结束

定义 做法 做进化() -> 空:
  日志("▶ AI 自进化 30 代")
  进化.建种群(12, 20261122)
  变量 行 : 序列 文本 = []
  变量 g : 数 = 0
  循环 g < 30:
    进化.进化一代()
    变量 优 : 任意 = 进化.最优基因()
    行 = 表.追加(行, "第" + 化成文(g + 1) + "代  " + 进化.两位(优.适应度))
    g = g + 1
  结束
  界面.界面_文本_t("进化区|" + 文字.合并(行, 换行()))
  变量 终 : 任意 = 进化.最优基因()
  日志("  最优适应度 " + 进化.两位(终.适应度))
  日志("  时间片 " + 进化.两位(终.时间片) + " 老化 " + 进化.两位(终.老化速率))
  刷新状态()
结束

定义 做法 做镜像() -> 空:
  日志("▶ 打包镜像")
  变量 分区 : 序列 序列 文本 = []
  分区 = 表.追加(分区, ["内核", "时钟=" + 化成文(内核.内核["时钟"])])
  分区 = 表.追加(分区, ["AI", "代数=" + 化成文(进化.进化["代数"])])
  变量 内容 : 文本 = 镜像.打包镜像(分区)
  变量 v : 映射 文本 文本 = 镜像.校验镜像(内容)
  文件.写入(系统.脚本目录() + "/../build/hengos.img", 内容)
  日志("  " + 化成文(文字.长度(内容)) + " 字符，校验 " + v["状态"])
  刷新状态()
结束

定义 做法 处理(事件 : 文本) -> 空:
  如果 文字.开头是(事件, "按钮|"):
    变量 动作 : 文本 = 文字.截(事件, 3)
    如果 动作 = "启动":
      做启动()
    结束
    如果 动作 = "调度":
      做调度()
    结束
    如果 动作 = "进化":
      做进化()
    结束
    如果 动作 = "镜像":
      做镜像()
    结束
    如果 动作 = "清空":
      置("日志", "")
      界面.界面_文本_t("日志|")
    结束
    如果 动作 = "退出":
      界面.界面_关闭_t("")
    结束
  结束
结束

开始:
  授权 文件.写入, 系统.脚本目录

  界面.界面_启动_t("衡 OS 控制台")
  界面.界面_加分区_t("状态区,0,0,24,75")
  界面.界面_加分区_t("日志,24,0,44,75")
  界面.界面_加分区_t("进化区,68,0,32,75")
  界面.界面_加分区_t("按钮区,0,75,100,25")

  界面.界面_文本_t("状态区|未启动")
  界面.界面_文本_t("日志|点下方「启动系统」")
  界面.界面_文本_t("进化区|尚未进化")

  界面.界面_按钮_t("按钮区,启动系统,启动")
  界面.界面_按钮_t("按钮区,运行调度,调度")
  界面.界面_按钮_t("按钮区,AI 进化,进化")
  界面.界面_按钮_t("按钮区,打包镜像,镜像")
  界面.界面_按钮_t("按钮区,清空日志,清空")
  界面.界面_按钮_t("按钮区,退出,退出")

  界面.界面_状态栏_t("衡 OS 就绪|衡语 v2.0|未启动")

  循环 真:
    如果 界面.界面_等待_t("50") = "1":
      变量 事件 : 文本 = 界面.界面_取结果("事件")
      如果 文字.长度(事件) > 0:
        处理(事件)
      结束
    结束
  结束
结束
