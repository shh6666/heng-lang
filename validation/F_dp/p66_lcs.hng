定义 做法 最长公共子序列(甲 : 文本, 乙 : 文本) -> 数:
  变量 a : 序列 文本 = 文字.切分(甲, "")
  变量 b : 序列 文本 = 文字.切分(乙, "")
  变量 n : 数 = 表.长度(a)
  变量 m : 数 = 表.长度(b)
  变量 dp : 序列 序列 数 = []
  变量 i : 数 = 0
  循环 i <= n:
    变量 行 : 序列 数 = []
    变量 j : 数 = 0
    循环 j <= m:
      行 = 表.追加(行, 0)
      j = j + 1
    结束
    dp = 表.追加(dp, 行)
    i = i + 1
  结束
  i = 1
  循环 i <= n:
    变量 j : 数 = 1
    循环 j <= m:
      如果 a[i - 1] = b[j - 1]:
        将 dp[i - 1][j - 1] + 1 放到 dp[i][j]
      否则:
        如果 dp[i - 1][j] > dp[i][j - 1]:
          将 dp[i - 1][j] 放到 dp[i][j]
        否则:
          将 dp[i][j - 1] 放到 dp[i][j]
        结束
      结束
      j = j + 1
    结束
    i = i + 1
  结束
  返回 dp[n][m]
结束
开始:
  说出 最长公共子序列("abcde", "ace")
结束
