定义 做法 编辑距离(甲 : 文本, 乙 : 文本) -> 数:
  变量 a : 序列 文本 = 文字.切分(甲, "")
  变量 b : 序列 文本 = 文字.切分(乙, "")
  变量 n : 数 = 表.长度(a)
  变量 m : 数 = 表.长度(b)
  变量 dp : 序列 序列 数 = []
  变量 i : 数 = 0
  循环 i <= n:
    变量 行 : 序列 数 = []
    变量 j : 数 = 0
    循环 j <= m:
      如果 i = 0:
        行 = 表.追加(行, j)
      否则:
        如果 j = 0:
          行 = 表.追加(行, i)
        否则:
          行 = 表.追加(行, 0)
        结束
      结束
      j = j + 1
    结束
    dp = 表.追加(dp, 行)
    i = i + 1
  结束
  i = 1
  循环 i <= n:
    变量 j : 数 = 1
    循环 j <= m:
      如果 a[i - 1] = b[j - 1]:
        将 dp[i - 1][j - 1] 放到 dp[i][j]
      否则:
        变量 最小 : 数 = dp[i - 1][j - 1]
        如果 dp[i - 1][j] < 最小:
          最小 = dp[i - 1][j]
        结束
        如果 dp[i][j - 1] < 最小:
          最小 = dp[i][j - 1]
        结束
        将 最小 + 1 放到 dp[i][j]
      结束
      j = j + 1
    结束
    i = i + 1
  结束
  返回 dp[n][m]
结束
开始:
  说出 编辑距离("kitten", "sitting")
结束
