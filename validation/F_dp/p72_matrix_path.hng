定义 做法 最小路径和(格 : 序列 序列 数) -> 数:
  变量 n : 数 = 表.长度(格)
  变量 m : 数 = 表.长度(格[0])
  变量 dp : 序列 序列 数 = []
  变量 i : 数 = 0
  循环 i < n:
    变量 行 : 序列 数 = []
    变量 j : 数 = 0
    循环 j < m:
      如果 i = 0 并且 j = 0:
        行 = 表.追加(行, 格[0][0])
      否则:
        如果 i = 0:
          行 = 表.追加(行, 行[j - 1] + 格[0][j])
        否则:
          如果 j = 0:
            行 = 表.追加(行, dp[i - 1][0] + 格[i][0])
          否则:
            变量 上 : 数 = dp[i - 1][j]
            变量 左 : 数 = 行[j - 1]
            如果 左 < 上:
              行 = 表.追加(行, 左 + 格[i][j])
            否则:
              行 = 表.追加(行, 上 + 格[i][j])
            结束
          结束
        结束
      结束
      j = j + 1
    结束
    dp = 表.追加(dp, 行)
    i = i + 1
  结束
  返回 dp[n - 1][m - 1]
结束
开始:
  说出 最小路径和([[1, 3, 1], [1, 5, 1], [4, 2, 1]])
结束
