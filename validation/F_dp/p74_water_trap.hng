定义 做法 接雨水(高 : 序列 数) -> 数:
  变量 n : 数 = 表.长度(高)
  如果 n < 3:
    返回 0
  结束
  变量 总 : 数 = 0
  变量 i : 数 = 1
  循环 i < n - 1:
    变量 左高 : 数 = 高[0]
    变量 k : 数 = 0
    循环 k < i:
      如果 高[k] > 左高:
        左高 = 高[k]
      结束
      k = k + 1
    结束
    变量 右高 : 数 = 高[i + 1]
    k = i + 1
    循环 k < n:
      如果 高[k] > 右高:
        右高 = 高[k]
      结束
      k = k + 1
    结束
    变量 矮 : 数 = 左高
    如果 右高 < 矮:
      矮 = 右高
    结束
    如果 矮 > 高[i]:
      总 = 总 + 矮 - 高[i]
    结束
    i = i + 1
  结束
  返回 总
结束
开始:
  说出 接雨水([0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1])
结束
