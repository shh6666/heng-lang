开始:
  变量 字母 : 文本 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  变量 表1 : 序列 文本 = 文字.切分(字母, "")
  变量 数据 : 序列 数 = [72, 105, 33]
  变量 结果 : 文本 = ""
  变量 i : 数 = 0
  循环 i < 表.长度(数据):
    变量 b0 : 数 = 数据[i]
    变量 b1 : 数 = 0
    变量 b2 : 数 = 0
    如果 i + 1 < 表.长度(数据):
      b1 = 数据[i + 1]
    结束
    如果 i + 2 < 表.长度(数据):
      b2 = 数据[i + 2]
    结束
    结果 = 结果 + 表1[数值.整除(b0, 4)]
    结果 = 结果 + 表1[数值.取余(b0, 4) * 16 + 数值.整除(b1, 16)]
    i = i + 3
  结束
  说出 结果
结束
