定义 做法 连通分量(邻接 : 序列 序列 数, n : 数) -> 数:
  变量 已访 : 序列 数 = []
  变量 i : 数 = 0
  循环 i < n:
    已访 = 表.追加(已访, 0)
    i = i + 1
  结束
  变量 分量 : 数 = 0
  i = 0
  循环 i < n:
    如果 已访[i] = 0:
      分量 = 分量 + 1
      变量 队列 : 序列 数 = [i]
      将 1 放到 已访[i]
      循环 表.长度(队列) > 0:
        变量 u : 数 = 队列[0]
        队列 = 表.片段(队列, 1, 表.长度(队列) - 1)
        每个 邻接[u] 为 v:
          如果 已访[v] = 0:
            将 1 放到 已访[v]
            队列 = 表.追加(队列, v)
          结束
        结束
      结束
    结束
    i = i + 1
  结束
  返回 分量
结束
开始:
  说出 连通分量([[1], [0], [3], [2], []], 5)
结束
