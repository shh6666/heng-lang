定义 做法 分词(表达式 : 文本) -> 序列 文本:
  变量 结果 : 序列 文本 = []
  变量 当前 : 文本 = ""
  每个 文字.切分(表达式, "") 为 c:
    如果 c = " ":
      如果 文字.长度(当前) > 0:
        结果 = 表.追加(结果, 当前)
        当前 = ""
      结束
    否则:
      如果 文字.含("+-*/()", c):
        如果 文字.长度(当前) > 0:
          结果 = 表.追加(结果, 当前)
          当前 = ""
        结束
        结果 = 表.追加(结果, c)
      否则:
        当前 = 当前 + c
      结束
    结束
  结束
  如果 文字.长度(当前) > 0:
    结果 = 表.追加(结果, 当前)
  结束
  返回 结果
结束
开始:
  说出 分词("12 + 3 * (4 - 1)")
结束
