定义 做法 因子(符号 : 序列 文本, 位 : 序列 数) -> 数:
  变量 i : 数 = 位[0]
  变量 s : 文本 = 符号[i]
  如果 s = "(":
    将 i + 1 放到 位[0]
    变量 v : 数 = 表达式求(符号, 位)
    将 位[0] + 1 放到 位[0]
    返回 v
  结束
  将 i + 1 放到 位[0]
  返回 化为数(s)
结束

定义 做法 项(符号 : 序列 文本, 位 : 序列 数) -> 数:
  变量 v : 数 = 因子(符号, 位)
  循环 位[0] < 表.长度(符号) 并且 (符号[位[0]] = "*" 或者 符号[位[0]] = "/"):
    变量 op : 文本 = 符号[位[0]]
    将 位[0] + 1 放到 位[0]
    变量 r : 数 = 因子(符号, 位)
    如果 op = "*":
      v = v * r
    否则:
      v = v / r
    结束
  结束
  返回 v
结束

定义 做法 表达式求(符号 : 序列 文本, 位 : 序列 数) -> 数:
  变量 v : 数 = 项(符号, 位)
  循环 位[0] < 表.长度(符号) 并且 (符号[位[0]] = "+" 或者 符号[位[0]] = "-"):
    变量 op : 文本 = 符号[位[0]]
    将 位[0] + 1 放到 位[0]
    变量 r : 数 = 项(符号, 位)
    如果 op = "+":
      v = v + r
    否则:
      v = v - r
    结束
  结束
  返回 v
结束
开始:
  变量 符号 : 序列 文本 = ["12", "+", "3", "*", "(", "4", "-", "1", ")"]
  变量 位 : 序列 数 = [0]
  说出 表达式求(符号, 位)
  变量 符号2 : 序列 文本 = ["2", "*", "3", "+", "4"]
  变量 位2 : 序列 数 = [0]
  说出 表达式求(符号2, 位2)
结束
