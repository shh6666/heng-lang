定义 做法 建失败表(p : 文本) -> 序列 数:
  变量 片 : 序列 文本 = 文字.切分(p, "")
  变量 表1 : 序列 数 = []
  变量 i : 数 = 0
  循环 i < 表.长度(片):
    表1 = 表.追加(表1, 0)
    i = i + 1
  结束
  变量 k : 数 = 0
  变量 j : 数 = 1
  循环 j < 表.长度(片):
    如果 片[j] = 片[k]:
      k = k + 1
      将 k 放到 表1[j]
      j = j + 1
    否则:
      如果 k > 0:
        k = 表1[k - 1]
      否则:
        将 0 放到 表1[j]
        j = j + 1
      结束
    结束
  结束
  返回 表1
结束
开始:
  说出 建失败表("ababaca")
结束
