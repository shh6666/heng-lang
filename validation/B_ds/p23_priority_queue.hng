定义 做法 推入(堆 : 序列 数, 值 : 数) -> 序列 数:
  变量 h : 序列 数 = 表.追加(堆, 值)
  变量 i : 数 = 表.长度(h) - 1
  循环 i > 0:
    变量 父 : 数 = 数值.整除(i - 1, 2)
    如果 h[父] <= h[i]:
      返回 h
    结束
    变量 t : 数 = h[父]
    将 h[i] 放到 h[父]
    将 t 放到 h[i]
    i = 父
  结束
  返回 h
结束
开始:
  变量 h : 序列 数 = []
  h = 推入(h, 5)
  h = 推入(h, 3)
  h = 推入(h, 8)
  h = 推入(h, 1)
  说出 h
  说出 h[0]
结束
