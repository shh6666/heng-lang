开始:
  变量 缓存 : 映射 文本 数 = {}
  变量 顺序 : 序列 文本 = []
  变量 容量 : 数 = 3
  每个 ["a", "b", "c", "d"] 为 键:
    如果 字典.有键(缓存, 键):
      将 表.过滤非空(顺序) 放到 顺序
    结束
    如果 字典.大小(缓存) >= 容量:
      变量 旧 : 文本 = 顺序[0]
      缓存 = 字典.删键(缓存, 旧)
      顺序 = 表.片段(顺序, 1, 表.长度(顺序) - 1)
    结束
    将 字典.大小(缓存) 放到 缓存[键]
    顺序 = 表.追加(顺序, 键)
  结束
  说出 字典.键(缓存)
  说出 顺序
结束
