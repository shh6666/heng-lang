定义 做法 找根(父 : 序列 数, x : 数) -> 数:
  循环 父[x] != x:
    x = 父[x]
  结束
  返回 x
结束

定义 做法 合并(父 : 序列 数, a : 数, b : 数) -> 空:
  变量 ra : 数 = 找根(父, a)
  变量 rb : 数 = 找根(父, b)
  如果 ra != rb:
    将 rb 放到 父[ra]
  结束
结束

开始:
  变量 父 : 序列 数 = [0, 1, 2, 3, 4]
  合并(父, 0, 1)
  合并(父, 2, 3)
  合并(父, 1, 3)
  说出 父
  说出 找根(父, 0) = 找根(父, 3)
  说出 找根(父, 0) = 找根(父, 4)
结束
